  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "sass": "^1.106.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.8"
