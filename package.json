{
  "name": "vue-datepicker",
  "version": "14.0.0",
  "description": "Datepicker component for Vue 3 (vendored source with local fixes)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
